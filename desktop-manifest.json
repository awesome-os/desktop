{
  "schema": "awesome-os-desktop-manifest-v1",
  "abiMagic": "0x33564742",
  "casLayout": "v11",
  "defaultDesktop": "sectium-desktop",
  "defaultGreeter": "lumi-chromatic-greeter",
  "boot": {
    "init": "./boot/src/init.c",
    "limineConfig": "./boot/config/limine.conf",
    "systemDefinition": "./boot/config/system.json",
    "netbootIpxe": "./boot/netboot/boot.ipxe",
    "hypervLauncher": "./boot/scripts/run-hyperv.ps1",
    "qemuLauncher": "./boot/scripts/run-qemu.ps1"
  },
  "devices": {
    "localities": ["local", "remote"],
    "surfaces": ["terminal", "desktop"],
    "management": {
      "protocol": "system://",
      "transports": ["pipe", "unix-socket", "mtls-tcp", "web-sw-opfs"],
      "remoteDeployable": true
    }
  },
  "desktops": [
    {
      "id": "sectium-desktop",
      "name": "Sectium Desktop",
      "summary": "Sectium Pure-Art Canvas + Sectium Browser + Code - OSS",
      "projectUri": "project://node/sectium-desktop?from=repository://github.com/awesome-os/sectium-browser@main",
      "runtime": "node",
      "compositor": "sectium-canvas",
      "surface": "desktop",
      "defaultGreeter": "lumi-chromatic-greeter",
      "casProjectionBytes": 0
    },
    {
      "id": "omarchy-hyprland",
      "name": "Omarchy Hyprland",
      "summary": "Omarchy Hyprland/Wayland BSP Tiling + 25 Cascading Themes",
      "projectUri": "project://coreutils/omarchy?from=repository://github.com/awesome-os/desktop-omarchy@main",
      "runtime": "coreutils",
      "compositor": "hyprland-wayland",
      "surface": "desktop",
      "defaultGreeter": "lumi-chromatic-greeter",
      "casProjectionBytes": 0
    },
    {
      "id": "noctalia-shell",
      "name": "Noctalia Shell",
      "summary": "Noctalia C++23 Native Wayland Shell & Miller Explorer",
      "projectUri": "project://coreutils/noctalia?from=repository://github.com/awesome-os/noctalia@main",
      "runtime": "coreutils",
      "compositor": "noctalia-wayland",
      "surface": "desktop",
      "defaultGreeter": "lumi-chromatic-greeter",
      "casProjectionBytes": 0
    },
    {
      "id": "chonkstep-wayland",
      "name": "ChonkStep Wayland",
      "summary": "Smithay 0.7.0 Floating Wayland (BeOS / OS2 / System7 / Modern)",
      "projectUri": "project://coreutils/chonkstep?from=repository://github.com/awesome-os/desktop@main",
      "runtime": "coreutils",
      "compositor": "smithay-wayland",
      "surface": "desktop",
      "defaultGreeter": "lumi-chromatic-greeter",
      "casProjectionBytes": 0
    },
    {
      "id": "gnome-wayland",
      "name": "GNOME Wayland (Debloated)",
      "summary": "Wayland-only Mutter + GNOME Shell (Xorg/Tracker/Evolution excluded, GDM/Software remapped to Awesome-OS)",
      "projectUri": "project://coreutils/gnome?from=repository://github.com/awesome-os/desktop@main",
      "runtime": "coreutils",
      "compositor": "mutter-wayland",
      "surface": "desktop",
      "defaultGreeter": "lumi-chromatic-greeter",
      "exclude": ["xorg-server", "gnome-software", "tracker-miner-fs", "evolution-data-server", "epiphany"],
      "remap": {
        "gdm": "awesome-os/desktop#greeter",
        "gnome-software": "awesome-os/holo-pm",
        "epiphany": "awesome-os/sectium-browser"
      },
      "casProjectionBytes": 0
    },
    {
      "id": "kde-plasma",
      "name": "KDE Plasma Wayland (Debloated)",
      "summary": "Wayland-only KWin + Plasma + shared Qt6 v11 CAS (Xorg/Baloo/Akonadi/Discover excluded & remapped)",
      "projectUri": "project://coreutils/kde-plasma?from=repository://github.com/awesome-os/desktop@main",
      "runtime": "coreutils",
      "compositor": "kwin-wayland",
      "surface": "desktop",
      "defaultGreeter": "lumi-chromatic-greeter",
      "exclude": ["xorg-server", "baloo", "discover", "akonadi", "drkonqi"],
      "remap": {
        "sddm": "awesome-os/desktop#greeter",
        "discover": "awesome-os/holo-pm",
        "display": "holo-display-qt"
      },
      "casProjectionBytes": 0
    },
    {
      "id": "kitty-ink-tui",
      "name": "Kitty-Ink Terminal",
      "summary": "Zero-GPU ANSI / Serial / SSH Terminal Device Surface",
      "projectUri": "project://node/kitty-ink?from=repository://github.com/awesome-os/desktop@main",
      "runtime": "node",
      "compositor": "kitty-ink-ansi",
      "surface": "terminal",
      "defaultGreeter": "tty-ink-greeter",
      "casProjectionBytes": 0
    }
  ],
  "greeters": [
    {
      "id": "lumi-chromatic-greeter",
      "name": "Lumi Chromatic Greeter",
      "summary": "GPU/Sectium Lumi Chromatic Startup Chooser",
      "mode": "gpu-canvas",
      "entrypoint": "./greeter/index.html"
    },
    {
      "id": "tty-ink-greeter",
      "name": "TTY-Ink Greeter",
      "summary": "Zero-GPU Kitty-Ink / ANSI Terminal Greeter (tty0 + ttyS0)",
      "mode": "tty-ansi"
    },
    {
      "id": "wol-warm-resume",
      "name": "WoL Warm Resume",
      "summary": "1-Way WoL Warm-RAM Instant Session Resume",
      "mode": "wol-warm-ram"
    }
  ]
}
